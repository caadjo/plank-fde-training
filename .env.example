# Local: blank DATABASE_URL uses persistent PGlite in .data/pg.
# Hosting/production: PostgreSQL URL is required; do not use local files on Vercel.
DATABASE_URL=

# Required only for the database MCP. Use a separate SELECT-only PostgreSQL role.
DATABASE_READONLY_URL=

# Optional: capture is disabled when POSTHOG_KEY is blank.
# The project key writes events. The personal key below reads events and stays local.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_HOST=https://us.posthog.com
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_KEY=

# Optional deployment metadata; defaults: development and local.
VERCEL_ENV=
VERCEL_GIT_COMMIT_SHA=
